  <end_effector name="bucket" parent_link="bucket" group="excavator_arm"/>

  <!-- Hydraulic cylinders and bucket linkage follow the arm (linkage_state_publisher) -->
  <passive_joint name="boom_cyl_barrel_joint"/>
  <passive_joint name="boom_cyl_rod_joint"/>
  <passive_joint name="stick_cyl_barrel_joint"/>
  <passive_joint name="stick_cyl_rod_joint"/>
  <passive_joint name="bucket_rocker_joint"/>
  <passive_joint name="bucket_hlink_joint"/>
  <passive_joint name="bucket_cyl_barrel_joint"/>
  <passive_joint name="bucket_cyl_rod_joint"/>
  <passive_joint name="blade_cyl_barrel_joint"/>
  <passive_joint name="blade_cyl_rod_joint"/>

  <disable_collisions link1="base_link" link2="base" reason="Adjacent"/>
  <disable_collisions link1="base" link2="blade" reason="Adjacent"/>
  <disable_collisions link1="base" link2="body" reason="Adjacent"/>
  <disable_collisions link1="body" link2="boom" reason="Adjacent"/>
  <disable_collisions link1="body" link2="sensor_imu_link" reason="Adjacent"/>
  <disable_collisions link1="body" link2="sensor_lidar_link" reason="Adjacent"/>
  <disable_collisions link1="boom" link2="stick" reason="Adjacent"/>
  <disable_collisions link1="bucket" link2="stick" reason="Adjacent"/>
  <disable_collisions link1="base" link2="boom" reason="Never"/>
  <disable_collisions link1="base" link2="sensor_imu_link" reason="Never"/>
  <disable_collisions link1="base" link2="sensor_lidar_link" reason="Never"/>
  <disable_collisions link1="base" link2="stick" reason="Never"/>
  <disable_collisions link1="blade" link2="body" reason="Never"/>
  <disable_collisions link1="blade" link2="boom" reason="Never"/>
  <disable_collisions link1="blade" link2="sensor_imu_link" reason="Never"/>
  <disable_collisions link1="blade" link2="sensor_lidar_link" reason="Never"/>
  <disable_collisions link1="body" link2="bucket" reason="Never"/>
  <disable_collisions link1="body" link2="stick" reason="Never"/>
  <disable_collisions link1="boom" link2="bucket" reason="Never"/>
  <disable_collisions link1="boom" link2="sensor_imu_link" reason="Never"/>
  <disable_collisions link1="boom" link2="sensor_lidar_link" reason="Never"/>
  <disable_collisions link1="bucket" link2="sensor_imu_link" reason="Never"/>
  <disable_collisions link1="bucket" link2="sensor_lidar_link" reason="Never"/>
  <disable_collisions link1="sensor_imu_link" link2="sensor_lidar_link" reason="Never"/>
  <disable_collisions link1="sensor_imu_link" link2="stick" reason="Never"/>
  <disable_collisions link1="sensor_lidar_link" link2="stick" reason="Never"/>
</robot>

