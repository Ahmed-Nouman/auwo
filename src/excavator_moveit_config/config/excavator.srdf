<?xml version="1.0" encoding="UTF-8"?>
<!-- SRDF for AUWO excavator — virtual joint ties model root to planning world frame. -->
<robot name="excavator">
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>

  <group name="excavator_arm">
    <chain base_link="base_link" tip_link="bucket"/>
  </group>

 <!-- Arm folded, bucket above ground (same as the v2 safe pose) -->
  <group_state name="Home" group="excavator_arm">
    <joint name="body_rotation" value="0"/>
    <joint name="boom_rotation" value="-0.25"/>
    <joint name="stick_rotation" value="0.6"/>
    <joint name="bucket_rotation" value="0.8"/>
  </group_state>
  
  <!-- Excavation cycle presets: scoop -> drag -> lift -> transport -> dump.
       Shown in the RViz MotionPlanning "Goal State" dropdown; also usable as named targets
       (MoveGroupInterface::setNamedTarget). Values stay inside the URDF joint limits and the
       planning body_rotation bound [-pi, pi].
       v2 sign convention: negative = boom up / stick out / bucket dump. -->
  <!-- Scoop: stick reached out, bucket open, teeth at the ground in front -->
  <group_state name="Dig" group="excavator_arm">
    <joint name="body_rotation" value="0"/>
    <joint name="boom_rotation" value="0.45"/>
    <joint name="stick_rotation" value="-0.75"/>
    <joint name="bucket_rotation" value="-0.9"/>
  </group_state>

  <!-- Drag: stick pulled in along the ground, bucket half curled -->
  <group_state name="Drag" group="excavator_arm">
    <joint name="body_rotation" value="0"/>
    <joint name="boom_rotation" value="0.3"/>
    <joint name="stick_rotation" value="0.35"/>
    <joint name="bucket_rotation" value="0.4"/>
  </group_state>

  <!-- Lift: boom up with the bucket fully curled (load held), still facing the dig -->
  <group_state name="Lift" group="excavator_arm">
    <joint name="body_rotation" value="0"/>
    <joint name="boom_rotation" value="-0.45"/>
    <joint name="stick_rotation" value="0.3"/>
    <joint name="bucket_rotation" value="1.2"/>
  </group_state>

  <!-- Transport: slewed to the dump truck (profile dump yaw), bucket curled and high -->
  <group_state name="Swing" group="excavator_arm">
    <joint name="body_rotation" value="0.74"/>
    <joint name="boom_rotation" value="-0.57"/>
    <joint name="stick_rotation" value="-0.3"/>
    <joint name="bucket_rotation" value="1.2"/>
  </group_state>

  <!-- Dump: over the truck, bucket opened (same as the cycle DUMP pose) -->
  <group_state name="Dump" group="excavator_arm">
    <joint name="body_rotation" value="0.74"/>
    <joint name="boom_rotation" value="-0.57"/>
    <joint name="stick_rotation" value="-0.85"/>
    <joint name="bucket_rotation" value="-1.5"/>
  </group_state>

  <!-- Excavation cycle presets: scoop -> drag -> lift -> transport -> dump.
       Shown in the RViz MotionPlanning "Goal State" dropdown; also usable as named targets
       (MoveGroupInterface::setNamedTarget). Values stay inside the URDF joint limits and the
       planning body_rotation bound [-pi, pi].
       v1 sign convention: more negative boom = boom up, more negative bucket = curled. -->
  <!-- Scoop: stick reached out, bucket open, teeth at the ground in front -->
  <group_state name="scoop" group="excavator_arm">
    <joint name="body_rotation" value="0"/>
    <joint name="boom_rotation" value="-0.35"/>
    <joint name="stick_rotation" value="-1.6"/>
    <joint name="bucket_rotation" value="-0.8"/>
  </group_state>

  <!-- Drag: stick pulled in along the ground, bucket half curled -->
  <group_state name="drag" group="excavator_arm">
    <joint name="body_rotation" value="0"/>
    <joint name="boom_rotation" value="-0.3"/>
    <joint name="stick_rotation" value="-0.6"/>
    <joint name="bucket_rotation" value="-1.4"/>
  </group_state>

  <!-- Lift: boom up with the bucket fully curled (load held), still facing the dig -->
  <group_state name="lift" group="excavator_arm">
    <joint name="body_rotation" value="0"/>
    <joint name="boom_rotation" value="-1.0"/>
    <joint name="stick_rotation" value="-1.0"/>
    <joint name="bucket_rotation" value="-2.0"/>
  </group_state>

  <!-- Transport: slewed to the dump truck (Dump preset yaw), bucket curled and high -->
  <group_state name="transport" group="excavator_arm">
    <joint name="body_rotation" value="0.611"/>
    <joint name="boom_rotation" value="-1.21"/>
    <joint name="stick_rotation" value="-1.3"/>
    <joint name="bucket_rotation" value="-2.0"/>
  </group_state>

  <!-- Dump: over the truck, bucket opened -->
  <group_state name="dump" group="excavator_arm">
    <joint name="body_rotation" value="0.611"/>
    <joint name="boom_rotation" value="-1.21"/>
    <joint name="stick_rotation" value="-1.6"/>
    <joint name="bucket_rotation" value="-0.6"/>
  </group_state>

  <end_effector name="bucket" parent_link="bucket" group="excavator_arm"/>

  <!-- Adjacent / fixed-attached links: disable to reduce false self-collisions from mesh coarseness -->
  <disable_collisions link1="base_link" link2="base" reason="Adjacent"/>
  <disable_collisions link1="base" link2="body" reason="Adjacent"/>
  <disable_collisions link1="body" link2="boom" reason="Adjacent"/>
  <disable_collisions link1="boom" link2="stick" reason="Adjacent"/>
  <disable_collisions link1="stick" link2="bucket" reason="Adjacent"/>
  <disable_collisions link1="body" link2="sensor_imu_link" reason="Adjacent"/>
  <disable_collisions link1="body" link2="sensor_lidar_link" reason="Adjacent"/>
  <disable_collisions link1="sensor_imu_link" link2="sensor_lidar_link" reason="Never"/>
  <disable_collisions link1="boom" link2="sensor_lidar_link" reason="Never"/>
  <disable_collisions link1="boom" link2="sensor_imu_link" reason="Never"/>
</robot>
