<?xml version="1.0"?>
<!--
  Mini excavator (new model), generated from Excavator_rig_packed.blend.
  Package excavator_v2_description ("v2"). Select it with excavator_model:=v2.
  Mirrors the interface of excavator_description ("v1"):
    * same link names  : base_link (massless root), base, body, boom, stick, bucket,
                         sensor_imu_link, sensor_lidar_link
    * same joint names : body_rotation, boom_rotation, stick_rotation, bucket_rotation
    * same sign convention (axis 0 1 0): negative = boom up / stick out / bucket dump
    * same use_mock_hardware switch, gz_ros2_control plugin, IMU and LiDAR sensors
  New:
    * blade + blade_rotation (negative = blade up)
    * hydraulic cylinders and bucket four-bar linkage as 10 position-controlled joints.
      URDF cannot close these loops; linkage_state_publisher computes them from the
      actuated joints and commands them through linkage_controller.
    * forward direction is +X of base_link (REP-103); the old file had a 180 deg yaw on base.
  Frames: X forward, Y left, Z up, metres. base_link is on the ground below the swing axis.
  Masses, inertias, efforts and joint limits are estimates.
-->
<robot name="excavator" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- When true: mock_components/GenericSystem for RViz-only MoveIt (no Gazebo). -->
  <xacro:arg name="use_mock_hardware" default="false"/>
  <!-- Accepted for compatibility with launch files that pass use_sim:=...; not used. -->
  <xacro:arg name="use_sim" default="true"/>

  <xacro:property name="mesh_uri" value="package://excavator_v2_description/meshes"/>

  <!-- ===================== helper macros ===================== -->

  <xacro:macro name="mesh_link" params="name mass com ixx iyy izz collision">
    <link name="${name}">
      <inertial>
        <origin xyz="${com}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" iyy="${iyy}" izz="${izz}" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_uri}/${name}.obj"/>
        </geometry>
      </visual>
      <xacro:if value="${collision}">
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="${mesh_uri}/${name}.obj"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>
  </xacro:macro>

  <!-- Passive pin of a cylinder or linkage part (driven by linkage_controller) -->
  <xacro:macro name="linkage_pin" params="name parent child xyz">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="1.0" friction="0.0"/>
      <limit effort="2000.0" lower="-3.14159" upper="3.14159" velocity="10.0"/>
    </joint>
  </xacro:macro>

  <!-- Cylinder rod sliding in its barrel (value = extension from rest length) -->
  <xacro:macro name="cylinder_rod" params="name parent child xyz axis lower upper">
    <joint name="${name}" type="prismatic">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="${axis}"/>
      <dynamics damping="1.0" friction="0.0"/>
      <limit effort="5000.0" lower="${lower}" upper="${upper}" velocity="5.0"/>
    </joint>
  </xacro:macro>

  <!-- ===================== links ===================== -->

  <!-- Massless root -->
  <link name="base_link"/>

  <!-- BASE: undercarriage, tracks -->
  <xacro:mesh_link name="base" collision="true" mass="900.0"
                   com="-0.0999 -0.0035 0.2521" ixx="185.574" iyy="279.609" izz="427.057"/>
  <!-- BODY / TURRET: cabin, counterweight, lights, boom swing bracket -->
  <xacro:mesh_link name="body" collision="true" mass="1100.0"
                   com="0.0384 0.0668 0.9960" ixx="569.702" iyy="645.747" izz="480.438"/>
  <!-- ARM1 (boom) -->
  <xacro:mesh_link name="boom" collision="true" mass="150.0"
                   com="0.9561 -0.0001 0.5116" ixx="15.693" iyy="64.404" izz="49.601"/>
  <!-- ARM2 (stick) -->
  <xacro:mesh_link name="stick" collision="true" mass="90.0"
                   com="0.2841 -0.0016 -0.4308" ixx="17.445" iyy="20.785" izz="4.128"/>
  <!-- SHOVEL (bucket) -->
  <xacro:mesh_link name="bucket" collision="true" mass="60.0"
                   com="-0.2439 0.0002 -0.2248" ixx="2.732" iyy="4.081" izz="3.638"/>
  <!-- Dozer blade -->
  <xacro:mesh_link name="blade" collision="true" mass="70.0"
                   com="0.4249 -0.0000 -0.0828" ixx="13.480" iyy="4.776" izz="17.402"/>

  <!-- Bucket linkage and hydraulic cylinders (visual only, no collision) -->
  <xacro:mesh_link name="bucket_rocker" collision="false" mass="8.0" com="0.1170 0.0000 -0.0289" ixx="0.0286" iyy="0.0714" izz="0.0788"/>
  <xacro:mesh_link name="bucket_hlink" collision="false" mass="8.0" com="-0.0553 0.0000 -0.0852" ixx="0.0670" iyy="0.0535" izz="0.0512"/>
  <xacro:mesh_link name="boom_cyl_barrel" collision="false" mass="25.0" com="0.1861 -0.0030 0.2256" ixx="0.5939" iyy="0.9845" izz="0.4342"/>
  <xacro:mesh_link name="boom_cyl_rod" collision="false" mass="10.0" com="-0.2366 -0.0018 -0.2938" ixx="0.3335" iyy="0.5544" izz="0.2261"/>
  <xacro:mesh_link name="stick_cyl_barrel" collision="false" mass="22.0" com="0.3208 0.0001 0.0251" ixx="0.0714" iyy="1.0110" izz="0.9921"/>
  <xacro:mesh_link name="stick_cyl_rod" collision="false" mass="9.0" com="-0.3624 0.0003 -0.0272" ixx="0.0124" iyy="0.4575" izz="0.4512"/>
  <xacro:mesh_link name="bucket_cyl_barrel" collision="false" mass="18.0" com="0.1312 0.0005 -0.2989" ixx="0.6465" iyy="0.7956" izz="0.1715"/>
  <xacro:mesh_link name="bucket_cyl_rod" collision="false" mass="7.0" com="-0.1345 0.0013 0.3126" ixx="0.2615" iyy="0.3162" izz="0.0572"/>
  <xacro:mesh_link name="blade_cyl_barrel" collision="false" mass="12.0" com="0.1899 0.0002 -0.0728" ixx="0.0813" iyy="0.2338" izz="0.1968"/>
  <xacro:mesh_link name="blade_cyl_rod" collision="false" mass="5.0" com="-0.1172 0.0014 0.0487" ixx="0.0101" iyy="0.0417" izz="0.0345"/>

  <!-- Sensor links (IMU and 3D LiDAR on the cab roof) - visible physical sensor geometry -->
  <link name="sensor_imu_link">
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="imu_visual">
      <geometry><box size="0.12 0.10 0.03"/></geometry>
      <origin xyz="0 0 0"/>
      <material name="imu_material">
        <color rgba="0.9 0.45 0.1 1"/>
      </material>
    </visual>
    <collision name="imu_collision">
      <geometry><box size="0.12 0.10 0.03"/></geometry>
      <origin xyz="0 0 0"/>
    </collision>
  </link>
  <link name="sensor_lidar_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="lidar_base">
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 3.14159"/>
      <material name="lidar_base_material">
        <color rgba="0.1 0.5 0.85 1"/>
      </material>
    </visual>
    <visual name="lidar_dome">
      <geometry><sphere radius="0.07"/></geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <material name="lidar_dome_material">
        <color rgba="0.2 0.6 0.9 0.95"/>
      </material>
    </visual>
    <collision name="lidar_collision">
      <geometry><cylinder radius="0.08" length="0.12"/></geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- ===================== actuated joints ===================== -->

  <!-- Fixed joint between base_link (root) and base. No 180 deg yaw any more: +X is forward. -->
  <joint name="base_to_base_link" type="fixed">
    <parent link="base_link"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Revolute with wide limits (not continuous): MoveIt + JointTrajectoryController validate the
       first waypoint against /joint_states; continuous joints often report large accumulated
       angles while planned trajectories use a different branch -> instant "start deviates" abort. -->
  <joint name="body_rotation" type="revolute">
    <parent link="base"/>
    <child link="body"/>
    <axis xyz="0 0 1"/>
    <origin xyz="0.000000 0.000000 0.504155"/>
    <dynamics damping="8.0" friction="0.5"/>
    <limit effort="20000.0" lower="-12.566370614359172" upper="12.566370614359172" velocity="1.5"/>
  </joint>

  <!-- Limits from cylinder stroke and lever arm (see README). negative = boom up -->
  <joint name="boom_rotation" type="revolute">
    <parent link="body"/>
    <child link="boom"/>
    <axis xyz="0 1 0"/>
    <origin xyz="0.656365 -0.119281 0.323714"/>
    <dynamics damping="10.0" friction="1.5"/>
    <limit effort="40000.0" lower="-0.598" upper="1.037" velocity="1.0"/>
  </joint>

  <!-- negative = stick out, positive = stick in -->
  <joint name="stick_rotation" type="revolute">
    <parent link="boom"/>
    <child link="stick"/>
    <axis xyz="0 1 0"/>
    <origin xyz="1.902815 -0.000264 0.797877"/>
    <dynamics damping="8.0" friction="1.2"/>
    <limit effort="25000.0" lower="-0.878" upper="1.047" velocity="1.0"/>
  </joint>

  <!-- negative = dump (open), positive = curl (close) -->
  <joint name="bucket_rotation" type="revolute">
    <parent link="stick"/>
    <child link="bucket"/>
    <axis xyz="0 1 0"/>
    <origin xyz="0.593054 -0.001579 -1.143821"/>
    <dynamics damping="6.0" friction="0.8"/>
    <limit effort="12000.0" lower="-1.944" upper="1.29" velocity="1.2"/>
  </joint>

  <!-- negative = blade up, positive = blade down -->
  <joint name="blade_rotation" type="revolute">
    <parent link="base"/>
    <child link="blade"/>
    <axis xyz="0 1 0"/>
    <origin xyz="0.445848 -0.003957 0.237288"/>
    <dynamics damping="8.0" friction="1.0"/>
    <limit effort="15000.0" lower="-0.349" upper="0.401" velocity="0.5"/>
  </joint>

  <!-- ===================== passive joints (linkage_controller) ===================== -->

  <!-- Bucket four-bar: rocker on the stick, H-link from rocker tip to bucket -->
  <xacro:linkage_pin name="bucket_rocker_joint" parent="stick" child="bucket_rocker" xyz="0.533786 -0.000680 -1.012250"/>
  <xacro:linkage_pin name="bucket_hlink_joint" parent="bucket_rocker" child="bucket_hlink" xyz="0.214502 -0.000000 -0.058659"/>

  <!-- Boom cylinder: barrel on body, rod pin on boom -->
  <xacro:linkage_pin name="boom_cyl_barrel_joint" parent="body" child="boom_cyl_barrel" xyz="0.860909 -0.117193 0.124177"/>
  <xacro:cylinder_rod name="boom_cyl_rod_joint" parent="boom_cyl_barrel" child="boom_cyl_rod" xyz="0.693968 -0.001478 0.861305"
                      axis="0.6274 0.0000 0.7787" lower="-0.2971" upper="0.1599"/>

  <!-- Stick cylinder: barrel on boom, rod pin on stick -->
  <xacro:linkage_pin name="stick_cyl_barrel_joint" parent="boom" child="stick_cyl_barrel" xyz="0.904857 -0.000101 1.014838"/>
  <xacro:cylinder_rod name="stick_cyl_rod_joint" parent="stick_cyl_barrel" child="stick_cyl_rod" xyz="1.036693 -0.000164 0.068846"
                      axis="0.9978 0.0000 0.0663" lower="-0.2400" upper="0.3110"/>

  <!-- Bucket cylinder: barrel on stick, rod pin on rocker tip -->
  <xacro:linkage_pin name="bucket_cyl_barrel_joint" parent="stick" child="bucket_cyl_barrel" xyz="0.330689 -0.000000 -0.076154"/>
  <xacro:cylinder_rod name="bucket_cyl_rod_joint" parent="bucket_cyl_barrel" child="bucket_cyl_rod" xyz="0.417599 -0.000680 -0.994755"
                      axis="0.3871 0.0000 -0.9220" lower="-0.3369" upper="0.1921"/>

  <!-- Blade cylinder: barrel on base, rod pin on blade -->
  <xacro:linkage_pin name="blade_cyl_barrel_joint" parent="base" child="blade_cyl_barrel" xyz="0.483991 -0.003561 0.357394"/>
  <xacro:cylinder_rod name="blade_cyl_rod_joint" parent="blade_cyl_barrel" child="blade_cyl_rod" xyz="0.458794 -0.000518 -0.175416"
                      axis="0.9341 0.0000 -0.3571" lower="-0.1762" upper="0.1098"/>

  <!-- Body -> sensor links (fixed, on the cab roof) -->
  <joint name="body_to_imu" type="fixed">
    <parent link="body"/>
    <child link="sensor_imu_link"/>
    <origin xyz="-0.5500 0.1600 1.7620" rpy="0 0 0"/>
  </joint>
  <joint name="body_to_lidar" type="fixed">
    <parent link="body"/>
    <child link="sensor_lidar_link"/>
    <origin xyz="-0.3000 0.1600 1.7670" rpy="0 0 0"/>
  </joint>

  <!-- ===================== ros2_control ===================== -->

  <xacro:macro name="position_joint" params="name initial:=0.0">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <!-- All joints start at 0 (the rig rest pose). 0 is inside every limit and the
       linkage initial values are consistent with it. -->
  <xacro:macro name="excavator_ros2_control_joints">
    <!-- actuated -->
    <xacro:position_joint name="body_rotation"/>
    <xacro:position_joint name="boom_rotation"/>
    <xacro:position_joint name="stick_rotation"/>
    <xacro:position_joint name="bucket_rotation"/>
    <xacro:position_joint name="blade_rotation"/>
    <!-- passive linkage (linkage_controller) -->
    <xacro:position_joint name="boom_cyl_barrel_joint"/>
    <xacro:position_joint name="boom_cyl_rod_joint"/>
    <xacro:position_joint name="stick_cyl_barrel_joint"/>
    <xacro:position_joint name="stick_cyl_rod_joint"/>
    <xacro:position_joint name="bucket_rocker_joint"/>
    <xacro:position_joint name="bucket_hlink_joint"/>
    <xacro:position_joint name="bucket_cyl_barrel_joint"/>
    <xacro:position_joint name="bucket_cyl_rod_joint"/>
    <xacro:position_joint name="blade_cyl_barrel_joint"/>
    <xacro:position_joint name="blade_cyl_rod_joint"/>
  </xacro:macro>

  <!-- ros2_control: Gazebo sim hardware (default) or mock hardware (RViz-only demo).
       Controllers (config/controllers.yaml): joint_state_broadcaster, arm_trajectory_controller
       (4 arm joints, same as v1), blade_controller, linkage_controller. -->
  <xacro:unless value="$(arg use_mock_hardware)">
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <xacro:excavator_ros2_control_joints/>
    </ros2_control>
    <gazebo>
      <plugin filename="libgz_ros2_control-system.so"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find excavator_v2_description)/config/controllers.yaml</parameters>
        <!-- faster tracking of position commands (default 0.1) -->
        <position_proportional_gain>0.3</position_proportional_gain>
      </plugin>
    </gazebo>
  </xacro:unless>

  <xacro:if value="$(arg use_mock_hardware)">
    <ros2_control name="MockHardwareSystem" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="mock_sensor_commands">false</param>
        <param name="position_state_following_offset">0.0</param>
      </hardware>
      <xacro:excavator_ros2_control_joints/>
    </ros2_control>
  </xacro:if>

  <!-- IMU sensor (Gazebo Harmonic); orange so visible in sim -->
  <gazebo reference="sensor_imu_link">
    <material>Gazebo/Orange</material>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>/excavator/imu</topic>
      <gz_frame_id>sensor_imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- 3D LiDAR sensor (gpu_lidar, Gazebo Harmonic); blue so visible in sim -->
  <gazebo reference="sensor_lidar_link">
    <material>Gazebo/Blue</material>
    <sensor name="lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>/excavator/points</topic>
      <gz_frame_id>sensor_lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <resolution>1.0</resolution>
            <min_angle>-0.261799</min_angle>
            <max_angle>0.261799</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.2</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

</robot>
