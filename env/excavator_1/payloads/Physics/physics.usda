            float physics:upperLimit = 179.99985
            custom float urdf:limit:effort = 2000
        }

        def PhysicsPrismaticJoint "blade_cyl_rod_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
            float drive:linear:physics:maxForce = 5000
            float newton:damping = 1
            float newton:velocityLimit = 5
            uniform token physics:axis = "X"
            custom rel physics:body0
            append rel physics:body0 = </excavator/Geometry/base_link/base/blade_cyl_barrel>
            custom rel physics:body1
            append rel physics:body1 = </excavator/Geometry/base_link/base/blade_cyl_barrel/blade_cyl_rod>
            point3f physics:localPos0 = (0.458794, -0.000518, -0.175416)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.9833795, 0, 0.18156202, 0)
            quatf physics:localRot1 = (0.9833795, 0, 0.18156202, 0)
            float physics:lowerLimit = -0.1762
            float physics:upperLimit = 0.1098
            custom float urdf:limit:effort = 5000
        }

        def PhysicsFixedJoint "base_to_base_link"
        {
            custom rel physics:body0
            append rel physics:body0 = </excavator>
            custom rel physics:body1
            append rel physics:body1 = </excavator/Geometry/base_link/base>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "body_to_imu"
        {
            custom rel physics:body0
            append rel physics:body0 = </excavator/Geometry/base_link/base/body>
            custom rel physics:body1
            append rel physics:body1 = </excavator/Geometry/base_link/base/body/sensor_imu_link>
            point3f physics:localPos0 = (-0.55, 0.16, 1.762)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "body_to_lidar"
        {
            custom rel physics:body0
            append rel physics:body0 = </excavator/Geometry/base_link/base/body>
            custom rel physics:body1
            append rel physics:body1 = </excavator/Geometry/base_link/base/body/sensor_lidar_link>
            point3f physics:localPos0 = (-0.3, 0.16, 1.767)
