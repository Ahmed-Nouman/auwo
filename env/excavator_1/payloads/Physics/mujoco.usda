#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "excavator"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "excavator"
{
    over "Physics"
    {
        over "body_rotation" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "boom_rotation" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "stick_rotation" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "bucket_rotation" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "blade_rotation" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "bucket_rocker_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "bucket_hlink_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "boom_cyl_barrel_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "boom_cyl_rod_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "stick_cyl_barrel_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "stick_cyl_rod_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "bucket_cyl_barrel_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "bucket_cyl_rod_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "blade_cyl_barrel_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "blade_cyl_rod_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "body_rotation_actuator"
        {
            uniform double mjc:forceRange:max = 20000
            uniform double mjc:forceRange:min = -20000
            custom rel mjc:target
            append rel mjc:target = </excavator/Physics/body_rotation>
        }

        def MjcActuator "boom_rotation_actuator"
        {
            uniform double mjc:forceRange:max = 40000
            uniform double mjc:forceRange:min = -40000
            custom rel mjc:target
            append rel mjc:target = </excavator/Physics/boom_rotation>
        }

        def MjcActuator "stick_rotation_actuator"
        {
            uniform double mjc:forceRange:max = 25000
            uniform double mjc:forceRange:min = -25000
            custom rel mjc:target
            append rel mjc:target = </excavator/Physics/stick_rotation>
        }

        def MjcActuator "bucket_rotation_actuator"
        {
            uniform double mjc:forceRange:max = 12000
            uniform double mjc:forceRange:min = -12000
            custom rel mjc:target
            append rel mjc:target = </excavator/Physics/bucket_rotation>
        }

        def MjcActuator "blade_rotation_actuator"
        {
            uniform double mjc:forceRange:max = 15000
            uniform double mjc:forceRange:min = -15000
            custom rel mjc:target
            append rel mjc:target = </excavator/Physics/blade_rotation>
        }

        def MjcActuator "bucket_rocker_joint_actuator"
        {
            uniform double mjc:forceRange:max = 2000
            uniform double mjc:forceRange:min = -2000
            custom rel mjc:target
            append rel mjc:target = </excavator/Physics/bucket_rocker_joint>
        }

        def MjcActuator "bucket_hlink_joint_actuator"
        {
            uniform double mjc:forceRange:max = 2000
            uniform double mjc:forceRange:min = -2000
            custom rel mjc:target
            append rel mjc:target = </excavator/Physics/bucket_hlink_joint>
        }

        def MjcActuator "boom_cyl_barrel_joint_actuator"
        {
            uniform double mjc:forceRange:max = 2000
            uniform double mjc:forceRange:min = -2000
            custom rel mjc:target
            append rel mjc:target = </excavator/Physics/boom_cyl_barrel_joint>
        }

        def MjcActuator "boom_cyl_rod_joint_actuator"
        {
            uniform double mjc:forceRange:max = 5000
            uniform double mjc:forceRange:min = -5000
            custom rel mjc:target
            append rel mjc:target = </excavator/Physics/boom_cyl_rod_joint>
        }

        def MjcActuator "stick_cyl_barrel_joint_actuator"
        {
            uniform double mjc:forceRange:max = 2000
            uniform double mjc:forceRange:min = -2000
            custom rel mjc:target
            append rel mjc:target = </excavator/Physics/stick_cyl_barrel_joint>
        }

        def MjcActuator "stick_cyl_rod_joint_actuator"
        {
            uniform double mjc:forceRange:max = 5000
            uniform double mjc:forceRange:min = -5000
            custom rel mjc:target
            append rel mjc:target = </excavator/Physics/stick_cyl_rod_joint>
        }

        def MjcActuator "bucket_cyl_barrel_joint_actuator"
        {
            uniform double mjc:forceRange:max = 2000
            uniform double mjc:forceRange:min = -2000
            custom rel mjc:target
            append rel mjc:target = </excavator/Physics/bucket_cyl_barrel_joint>
        }

        def MjcActuator "bucket_cyl_rod_joint_actuator"
        {
            uniform double mjc:forceRange:max = 5000
            uniform double mjc:forceRange:min = -5000
            custom rel mjc:target
            append rel mjc:target = </excavator/Physics/bucket_cyl_rod_joint>
        }

        def MjcActuator "blade_cyl_barrel_joint_actuator"
        {
            uniform double mjc:forceRange:max = 2000
            uniform double mjc:forceRange:min = -2000
            custom rel mjc:target
            append rel mjc:target = </excavator/Physics/blade_cyl_barrel_joint>
        }

        def MjcActuator "blade_cyl_rod_joint_actuator"
        {
            uniform double mjc:forceRange:max = 5000
            uniform double mjc:forceRange:min = -5000
            custom rel mjc:target
            append rel mjc:target = </excavator/Physics/blade_cyl_rod_joint>
        }
    }
}

