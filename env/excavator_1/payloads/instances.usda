#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "base" (
        prepend references = @./geometries.usd@</Geometries/base>
    )
    {
        over "base" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/base/VisualMaterials/Excavator>
        }

        def Scope "VisualMaterials"
        {
            def Material "Excavator" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/Excavator>
            )
            {
            }
        }
    }

    def Xform "base_1" (
        prepend references = @./geometries.usd@</Geometries/base>
    )
    {
        over "base" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }

